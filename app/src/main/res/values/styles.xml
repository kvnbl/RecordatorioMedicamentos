<?xml version="1.0"?>
<resources>
  <style name="MedAlarmTextPageTitle">
    <item name="android:textSize">@dimen/ui_text_page_title</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="MedAlarmTextSectionTitle">
    <item name="android:textSize">@dimen/ui_text_section_title</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="MedAlarmTextBody">
    <item name="android:textSize">@dimen/ui_text_body</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textStyle">normal</item>
  </style>
  <style name="MedAlarmTextBodyStrong" parent="MedAlarmTextBody">
    <item name="android:textStyle">bold</item>
  </style>
  <style name="MedAlarmTextSecondary">
    <item name="android:textSize">@dimen/ui_text_secondary</item>
    <item name="android:textColor">@color/text_secondary</item>
    <item name="android:textStyle">normal</item>
  </style>
  <style name="MedAlarmTextSecondaryStrong" parent="MedAlarmTextSecondary">
    <item name="android:textStyle">bold</item>
  </style>
  <style name="MedAlarmTextDisplayAlarm" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/ui_text_alarm_time</item>
    <item name="android:textColor">@color/brand_primary</item>
  </style>
  <style name="MedAlarmTextDisplayMetric" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/ui_text_report_metric</item>
    <item name="android:textColor">@color/brand_primary</item>
  </style>
  <style name="MedAlarmHistoryRecordTitle" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/history_record_title</item>
  </style>
  <style name="MedAlarmHistoryRecordTime" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/history_record_time</item>
    <item name="android:textColor">@color/history_blue_strong</item>
  </style>
  <style name="MedAlarmHistoryRecordStatus" parent="MedAlarmTextSecondaryStrong">
    <item name="android:textSize">@dimen/history_record_status</item>
  </style>
  <style name="MedAlarmAlarmListTime" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/alarm_list_time</item>
    <item name="android:textColor">@color/brand_primary</item>
  </style>
  <style name="MedAlarmAlarmItemTitle" parent="MedAlarmTextBodyStrong">
    <item name="android:textSize">@dimen/alarm_item_title</item>
  </style>
  <style name="MedAlarmAlarmItemSecondary" parent="MedAlarmTextSecondary">
    <item name="android:textSize">@dimen/alarm_item_secondary</item>
  </style>
  <style name="MedAlarmAlarmItemStatus" parent="MedAlarmTextSecondaryStrong">
    <item name="android:textSize">@dimen/alarm_item_secondary</item>
  </style>
  <style name="MedAlarmAlarmItemPeriod" parent="MedAlarmTextSecondaryStrong">
    <item name="android:textSize">@dimen/alarm_item_secondary</item>
    <item name="android:textColor">@color/brand_primary</item>
  </style>
  <style name="MedAlarmTextTimeSeparator" parent="MedAlarmTextBody">
    <item name="android:textSize">@dimen/ui_text_time_wheel</item>
  </style>
  <style name="FunctionalIcon">
    <item name="android:layout_width">@dimen/ui_icon_size</item>
    <item name="android:layout_height">@dimen/ui_icon_size</item>
    <item name="android:contentDescription">@null</item>
    <item name="android:scaleType">fitCenter</item>
  </style>
  <style name="EmptyStateIllustration">
    <item name="android:layout_width">@dimen/ui_empty_state_icon_container</item>
    <item name="android:layout_height">@dimen/ui_empty_state_icon_container</item>
    <item name="android:padding">20dp</item>
    <item name="android:background">@drawable/bg_empty_state_icon</item>
    <item name="android:contentDescription">@null</item>
    <item name="android:scaleType">fitCenter</item>
  </style>
  <style name="PrimaryActionButton" parent="Widget.Material3.Button">
    <item name="android:background">@drawable/bg_primary_button</item>
    <item name="backgroundTint">@null</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/ui_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="cornerRadius">28dp</item>
    <item name="android:elevation">4dp</item>
    <item name="iconSize">24dp</item>
    <item name="iconPadding">@dimen/ui_space_8</item>
    <item name="android:paddingStart">@dimen/ui_container_padding</item>
    <item name="android:paddingEnd">@dimen/ui_container_padding</item>
    <item name="android:paddingTop">@dimen/ui_space_16</item>
    <item name="android:paddingBottom">@dimen/ui_space_16</item>
    <item name="android:minHeight">@dimen/ui_button_height</item>
  </style>
  <style name="SecondaryOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:textColor">@color/brand_primary</item>
    <item name="strokeColor">@color/brand_primary</item>
    <item name="strokeWidth">1.5dp</item>
    <item name="cornerRadius">28dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/ui_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="iconSize">24dp</item>
    <item name="iconPadding">@dimen/ui_space_8</item>
    <item name="android:paddingStart">@dimen/ui_container_padding</item>
    <item name="android:paddingEnd">@dimen/ui_container_padding</item>
    <item name="android:paddingTop">@dimen/ui_space_16</item>
    <item name="android:paddingBottom">@dimen/ui_space_16</item>
  </style>
  <style name="SidebarSignOutButton" parent="Widget.Material3.Button">
    <item name="android:background">@drawable/bg_sidebar_sign_out</item>
    <item name="backgroundTint">@null</item>
    <item name="android:textColor">@color/brand_primary</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/ui_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="cornerRadius">28dp</item>
    <item name="android:elevation">0dp</item>
    <item name="iconSize">24dp</item>
    <item name="iconPadding">@dimen/ui_space_12</item>
    <item name="iconTint">@color/brand_primary</item>
    <item name="android:paddingStart">@dimen/ui_container_padding</item>
    <item name="android:paddingEnd">@dimen/ui_container_padding</item>
    <item name="android:minHeight">56dp</item>
  </style>
  <style name="DeviceConnectionButton" parent="Widget.Material3.Button">
    <item name="android:textColor">@color/white</item>
    <item name="backgroundTint">@color/device_accent</item>
    <item name="cornerRadius">28dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/ui_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingStart">20dp</item>
    <item name="android:paddingEnd">20dp</item>
    <item name="android:paddingTop">8dp</item>
    <item name="android:paddingBottom">8dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
  <style name="SectionIconLabel">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">horizontal</item>
  </style>
  <style name="SectionIcon">
    <item name="android:layout_width">40dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:background">@drawable/bg_section_icon</item>
    <item name="android:padding">8dp</item>
    <item name="android:contentDescription">@null</item>
    <item name="tint">@color/brand_primary</item>
  </style>
  <style name="SectionLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginStart">12dp</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textAppearance">@style/MedAlarmTextBodyStrong</item>
    <item name="android:textStyle">bold</item>
  </style>
</resources>
