<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_logout_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_section_icon">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                app:tint="@color/brand_primary" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/addMedicineTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_medicine_title"
                android:textAppearance="@style/MedAlarmTextSectionTitle"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/addMedicineSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/MedAlarmTextSecondary"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/medicineInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:boxBackgroundColor="@color/input_surface"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/ui_radius_field"
        app:boxCornerRadiusBottomStart="@dimen/ui_radius_field"
        app:boxCornerRadiusTopEnd="@dimen/ui_radius_field"
        app:boxCornerRadiusTopStart="@dimen/ui_radius_field"
        app:boxStrokeColor="@color/input_stroke"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMedicineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/medicine_hint"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="1"
            android:minHeight="50dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="@style/MedAlarmTextBody"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/doseInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/input_surface"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/ui_radius_field"
        app:boxCornerRadiusBottomStart="@dimen/ui_radius_field"
        app:boxCornerRadiusTopEnd="@dimen/ui_radius_field"
        app:boxCornerRadiusTopStart="@dimen/ui_radius_field"
        app:boxStrokeColor="@color/input_stroke"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMedicineDose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dose_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="1"
            android:minHeight="50dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="@style/MedAlarmTextBody"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMedicineCancel"
            style="@style/SecondaryOutlineButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_cancel" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMedicineConfirm"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_medicine_action" />
    </LinearLayout>
</LinearLayout>
