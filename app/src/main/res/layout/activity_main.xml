<?xml version="1.0" encoding="utf-8"?>
<com.example.recordatoriomedicamentos.MedAlarmRoot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_background">
  <ScrollView android:id="@+id/loginScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <com.example.recordatoriomedicamentos.AdaptiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingStart="@dimen/ui_page_padding" android:paddingEnd="@dimen/ui_page_padding" android:paddingTop="24dp" android:paddingBottom="24dp" android:layout_gravity="center_horizontal">
      <ImageView android:layout_width="240dp" android:layout_height="80dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp" android:adjustViewBounds="true" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/sidebar_logo"/>
      <LinearLayout android:id="@+id/loginCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_login_form" android:elevation="0dp" android:orientation="vertical" android:padding="@dimen/ui_container_padding">
        <LinearLayout style="@style/SectionIconLabel">
          <ImageView style="@style/SectionIcon" android:src="@drawable/ic_mail"/>
          <TextView style="@style/SectionLabel" android:labelFor="@id/etCorreo" android:text="@string/field_email"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundColor="@color/input_surface" app:boxBackgroundMode="outline" app:boxCornerRadiusBottomEnd="@dimen/ui_radius_field" app:boxCornerRadiusBottomStart="@dimen/ui_radius_field" app:boxCornerRadiusTopEnd="@dimen/ui_radius_field" app:boxCornerRadiusTopStart="@dimen/ui_radius_field" app:boxStrokeColor="@color/input_stroke" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp" app:hintEnabled="false">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="emailAddress" android:hint="@string/email_hint" android:imeOptions="actionNext" android:inputType="textEmailAddress" android:maxLines="1" android:minHeight="50dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:textAppearance="@style/MedAlarmTextBody" android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout style="@style/SectionIconLabel" android:layout_marginTop="18dp">
          <ImageView style="@style/SectionIcon" android:src="@drawable/ic_lock"/>
          <TextView style="@style/SectionLabel" android:labelFor="@id/etContrasena" android:text="@string/field_password"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundColor="@color/input_surface" app:boxBackgroundMode="outline" app:boxCornerRadiusBottomEnd="@dimen/ui_radius_field" app:boxCornerRadiusBottomStart="@dimen/ui_radius_field" app:boxCornerRadiusTopEnd="@dimen/ui_radius_field" app:boxCornerRadiusTopStart="@dimen/ui_radius_field" app:boxStrokeColor="@color/input_stroke" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp" app:endIconDrawable="@drawable/ic_password_toggle" app:endIconMode="password_toggle" app:endIconTint="@color/text_secondary" app:hintEnabled="false">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etContrasena" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="password" android:hint="@string/field_password" android:imeOptions="actionDone" android:inputType="textPassword" android:maxLines="1" android:minHeight="50dp" android:paddingStart="16dp" android:paddingEnd="8dp" android:textAppearance="@style/MedAlarmTextBody" android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:id="@+id/authError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="assertive" android:background="@drawable/bg_auth_error" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/ui_container_padding" android:visibility="gone">
          <ImageView style="@style/FunctionalIcon" android:src="@drawable/ic_warning" app:tint="@color/error_red"/>
          <TextView android:id="@+id/tvAuthError" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textAppearance="@style/MedAlarmTextSecondary" android:textColor="@color/error_red" android:textStyle="bold"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="52dp">
          <com.google.android.material.button.MaterialButton android:id="@+id/btnIngresar" style="@style/PrimaryActionButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/action_sign_in" app:icon="@drawable/ic_login" app:iconGravity="textStart" app:iconTint="@color/white"/>
          <ProgressBar android:id="@+id/loginProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:indeterminateTint="@color/white" android:visibility="gone"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minHeight="32dp" android:orientation="horizontal">
          <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider_lavender"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:text="@string/or" android:textAppearance="@style/MedAlarmTextSecondaryStrong" android:textColor="@color/text_secondary"/>
          <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider_lavender"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRegistrarse" style="@style/SecondaryOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="52dp" android:text="@string/action_create_account" app:icon="@drawable/ic_person_add" app:iconGravity="textStart" app:iconTint="@color/brand_primary"/>
      </LinearLayout>
    </com.example.recordatoriomedicamentos.AdaptiveContentLayout>
  </ScrollView>
</com.example.recordatoriomedicamentos.MedAlarmRoot>
