<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_logout_dialog" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirmar toma" android:textColor="@color/text_primary" android:textAppearance="@style/MedAlarmTextSectionTitle"/>
  <TextView android:id="@+id/historyAnswerDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextBody"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/historyAnswerTaken" style="@style/PrimaryActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="24dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="Confirmar tomada"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/historyAnswerMissed" style="@style/SecondaryOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="Confirmar no tomada" android:textColor="@color/error_red" app:strokeColor="@color/error_red" xmlns:app="http://schemas.android.com/apk/res-auto"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/historyAnswerCancel" style="@style/SecondaryOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="Cancelar" android:textColor="@color/text_secondary" app:strokeColor="@color/text_secondary" xmlns:app="http://schemas.android.com/apk/res-auto"/>
</LinearLayout>
