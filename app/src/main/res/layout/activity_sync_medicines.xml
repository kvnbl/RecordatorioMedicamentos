<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_header_gradient">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">
        <com.example.recordatoriomedicamentos.MedAlarmRoot
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_background"
            app:dashboardWaveOffset="58dp"
            app:dashboardWaveTopOffset="12dp">
            <com.example.recordatoriomedicamentos.AdaptiveContentLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_page_padding"
                android:paddingTop="@dimen/dashboard_top_padding"
                android:paddingEnd="@dimen/ui_page_padding"
                android:paddingBottom="@dimen/ui_space_24">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/btnSyncBack"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/action_back"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_back"
                            android:textAppearance="@style/MedAlarmTextBody"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/alarm_sync_title"
                    android:textAppearance="@style/MedAlarmTextPageTitle"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/tvSyncSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/MedAlarmTextSecondary"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tvSyncMedicinesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/alarm_sync_choose_medicines"
                    android:textAppearance="@style/MedAlarmTextSectionTitle"
                    android:textColor="@color/text_primary" />
                <LinearLayout
                    android:id="@+id/syncMedicineList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/alarm_sync_choose_days"
                    android:textAppearance="@style/MedAlarmTextSectionTitle"
                    android:textColor="@color/text_primary" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/syncWeekdayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/MedAlarmTextSecondary"
                    android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncApply"
                    style="@style/PrimaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="56dp"
                    android:enabled="false"
                    android:text="@string/alarm_sync_action" />
            </com.example.recordatoriomedicamentos.AdaptiveContentLayout>
        </com.example.recordatoriomedicamentos.MedAlarmRoot>
    </ScrollView>
</FrameLayout>
