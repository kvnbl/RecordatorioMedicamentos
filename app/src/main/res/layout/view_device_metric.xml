<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_device_metric" android:gravity="top" android:minHeight="104dp" android:orientation="vertical" android:padding="@dimen/ui_space_12">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/metricIcon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_bluetooth" android:tint="@color/device_accent"/>
    <TextView android:id="@+id/metricTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_space_8" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_primary" android:textAppearance="@style/MedAlarmTextBodyStrong"/>
  </LinearLayout>
  <TextView android:id="@+id/metricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary"/>
</LinearLayout>
