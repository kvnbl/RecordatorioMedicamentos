<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_history_header_gradient">
  <ScrollView android:id="@+id/historyScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <com.example.recordatoriomedicamentos.MedAlarmRoot android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/history_page_background" app:dashboardWaveOffset="58dp" app:dashboardWaveTopOffset="12dp" app:waveStrongStartColor="@color/history_blue_light" app:waveStrongEndColor="@color/history_blue_strong" app:waveLightColor="@color/history_surface">
      <com.example.recordatoriomedicamentos.AdaptiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/ui_page_padding" android:paddingTop="@dimen/dashboard_top_padding" android:paddingEnd="@dimen/ui_page_padding" android:paddingBottom="@dimen/ui_space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
          <LinearLayout android:id="@+id/btnVolver" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/action_back" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:paddingStart="0dp" android:paddingTop="@dimen/ui_space_12" android:paddingEnd="@dimen/ui_space_24" android:paddingBottom="@dimen/ui_space_12" android:src="@drawable/ic_arrow_back" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_back" android:textColor="@color/white" android:textAppearance="@style/MedAlarmTextBody"/>
          </LinearLayout>
          <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/historyHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="@dimen/ui_space_16">
          <LinearLayout android:id="@+id/historyHeroCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/tvHistoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_title" android:textAppearance="@style/MedAlarmTextPageTitle"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_4" android:text="@string/history_subtitle" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary"/>
          </LinearLayout>
          <ImageView android:id="@+id/historyHeroIllustration" android:layout_width="112dp" android:layout_height="112dp" android:layout_marginStart="@dimen/ui_space_8" android:contentDescription="@string/history_illustration_description" android:scaleType="fitCenter" android:src="@drawable/history_clipboard_capsules"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/historyTodaySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:background="@drawable/bg_history_summary" android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_today_summary" android:textAppearance="@style/MedAlarmTextSectionTitle"/>
          <GridLayout android:id="@+id/historySummaryGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_12" android:columnCount="3" android:useDefaultMargins="false">
            <include android:id="@+id/historyTakenKpi" layout="@layout/view_history_kpi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp"/>
            <include android:id="@+id/historyMissedKpi" layout="@layout/view_history_kpi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp"/>
            <include android:id="@+id/historyLateKpi" layout="@layout/view_history_kpi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp"/>
          </GridLayout>
        </LinearLayout>
        <TextView android:id="@+id/tvHistoryState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_16" android:accessibilityLiveRegion="polite" android:text="@string/history_loading" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryRetry" style="@style/SecondaryOutlineButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:minHeight="48dp" android:text="@string/action_retry_short" android:textColor="@color/history_blue_strong" app:strokeColor="@color/history_blue_strong" android:visibility="gone"/>
        <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_4" android:orientation="vertical"/>
      </com.example.recordatoriomedicamentos.AdaptiveContentLayout>
    </com.example.recordatoriomedicamentos.MedAlarmRoot>
  </ScrollView>
</FrameLayout>
