<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#16324F"
            android:backgroundTint="#DCE8EF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nuevo recordatorio"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#16324F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/etMedicamento"
            android:text="Medicamento"
            android:textSize="16sp"
            android:textColor="#16324F" />

        <EditText
            android:id="@+id/etMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="Nombre del medicamento"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:textColor="#16324F"
            android:textColorHint="#526171"
            android:backgroundTint="#176B87" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/etDosis"
            android:text="Dosis indicada"
            android:textSize="16sp"
            android:textColor="#16324F" />

        <EditText
            android:id="@+id/etDosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="Por ejemplo, 1 comprimido"
            android:inputType="text"
            android:maxLength="80"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:textColor="#16324F"
            android:textColorHint="#526171"
            android:backgroundTint="#176B87" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Días y hora"
            android:textSize="16sp"
            android:textColor="#16324F" />

        <Button
            android:id="@+id/btnDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Seleccionar días"
            android:textAllCaps="false"
            android:textColor="#16324F"
            android:backgroundTint="#DCE8EF" />

        <Button
            android:id="@+id/btnHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Hora: 08:00"
            android:textAllCaps="false"
            android:textColor="#16324F"
            android:backgroundTint="#DCE8EF" />

        <TextView
            android:id="@+id/tvZonaHoraria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#526171" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Compartimiento del pastillero"
            android:textSize="16sp"
            android:textColor="#16324F" />

        <RadioGroup
            android:id="@+id/rgCompartimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@id/rbCompartimiento1">

            <RadioButton
                android:id="@+id/rbCompartimiento1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="1"
                android:textColor="#16324F"
                android:buttonTint="#176B87" />

            <RadioButton
                android:id="@+id/rbCompartimiento2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:minHeight="48dp"
                android:text="2"
                android:textColor="#16324F"
                android:buttonTint="#176B87" />
        </RadioGroup>

        <Button
            android:id="@+id/btnGuardarRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="16dp"
            android:text="Guardar recordatorio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#176B87" />

        <TextView
            android:id="@+id/tvEstadoGuardado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="15sp"
            android:textColor="#16324F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tus recordatorios"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#16324F" />

        <TextView
            android:id="@+id/tvRecordatorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Consultando recordatorios…"
            android:textSize="16sp"
            android:textColor="#526171" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Historial de confirmaciones"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#16324F" />

        <TextView
            android:id="@+id/tvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Consultando historial…"
            android:textSize="16sp"
            android:textColor="#526171"
            android:accessibilityLiveRegion="polite" />

    </LinearLayout>

</ScrollView>