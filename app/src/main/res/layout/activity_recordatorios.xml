<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_dashboard_header_gradient">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <com.example.recordatoriomedicamentos.MedAlarmRoot android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/page_background" app:dashboardWaveOffset="58dp" app:dashboardWaveTopOffset="12dp">
      <com.example.recordatoriomedicamentos.AdaptiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/ui_page_padding" android:paddingTop="@dimen/dashboard_top_padding" android:paddingEnd="@dimen/ui_page_padding" android:paddingBottom="@dimen/ui_space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
          <LinearLayout android:id="@+id/btnVolver" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/action_back" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:paddingTop="@dimen/ui_space_12" android:paddingEnd="@dimen/ui_space_24" android:paddingBottom="@dimen/ui_space_12" android:src="@drawable/ic_arrow_back" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_back" android:textColor="@color/white" android:textAppearance="@style/MedAlarmTextBody"/>
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/alarmHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="@dimen/ui_space_16">
          <LinearLayout android:id="@+id/alarmHeroCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/tvAlarmTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_alarms" android:textAppearance="@style/MedAlarmTextPageTitle"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_4" android:text="@string/alarm_list_subtitle" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary"/>
          </LinearLayout>
          <ImageView android:id="@+id/alarmHeroIllustration" android:layout_width="@dimen/device_hero_art_size" android:layout_height="@dimen/device_hero_art_size" android:layout_marginStart="@dimen/ui_space_8" android:contentDescription="@string/alarm_illustration_description" android:scaleType="fitCenter" android:src="@drawable/alarm_clock_illustration"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGlobalReminder" style="@style/PrimaryActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:minHeight="52dp" android:text="Recordatorio Global" app:icon="@drawable/ic_add" app:iconGravity="textStart" app:iconTint="@color/white"/>
        <TextView android:id="@+id/tvRecordatorios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_16" android:accessibilityLiveRegion="polite" android:text="@string/loading_alarms" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary" android:visibility="visible"/>
        <FrameLayout android:id="@+id/alarmContentArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:minHeight="280dp">
          <LinearLayout android:id="@+id/listRecordatorios" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
          <LinearLayout android:id="@+id/alarmEmptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/ui_space_24" android:visibility="gone">
            <ImageView style="@style/EmptyStateIllustration" android:contentDescription="@null" android:src="@drawable/ic_alarm" android:tint="@color/brand_primary"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_24" android:gravity="center" android:text="@string/alarms_empty" android:textColor="@color/text_primary" android:textAppearance="@style/MedAlarmTextPageTitle" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_8" android:gravity="center" android:text="@string/alarms_empty_hint" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextBody"/>
          </LinearLayout>
        </FrameLayout>
      </com.example.recordatoriomedicamentos.AdaptiveContentLayout>
    </com.example.recordatoriomedicamentos.MedAlarmRoot>
  </ScrollView>
</FrameLayout>
