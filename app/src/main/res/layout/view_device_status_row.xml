<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="vertical" android:paddingVertical="@dimen/ui_space_12">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/deviceRowIcon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_info" android:tint="@color/device_accent"/>
    <TextView android:id="@+id/deviceRowLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_space_12" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_primary" android:textAppearance="@style/MedAlarmTextBodyStrong"/>
  </LinearLayout>
  <TextView android:id="@+id/deviceRowValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginTop="@dimen/ui_space_4" android:gravity="start" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondaryStrong"/>
</LinearLayout>
