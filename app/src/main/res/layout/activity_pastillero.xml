<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_device_header_gradient">
  <ScrollView android:id="@+id/deviceScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <com.example.recordatoriomedicamentos.MedAlarmRoot android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/device_surface" app:dashboardWaveOffset="58dp" app:dashboardWaveTopOffset="12dp" app:waveStrongStartColor="@color/device_wave_strong_start" app:waveStrongEndColor="@color/device_wave_strong_end" app:waveLightColor="@color/device_wave_light">
      <com.example.recordatoriomedicamentos.AdaptiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/ui_page_padding" android:paddingTop="@dimen/dashboard_top_padding" android:paddingEnd="@dimen/ui_page_padding" android:paddingBottom="@dimen/ui_space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
          <LinearLayout android:id="@+id/btnVolver" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_back" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:paddingStart="0dp" android:paddingTop="@dimen/ui_space_12" android:paddingEnd="@dimen/ui_space_24" android:paddingBottom="@dimen/ui_space_12" android:src="@drawable/ic_arrow_back" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_back" android:textColor="@color/white" android:textAppearance="@style/MedAlarmTextBody"/>
          </LinearLayout>
          <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/deviceHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="@dimen/ui_space_16">
          <LinearLayout android:id="@+id/deviceHeroCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:translationY="-8dp">
            <TextView android:id="@+id/tvDeviceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_title" android:textAppearance="@style/MedAlarmTextPageTitle"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_4" android:text="@string/device_hero_subtitle" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondary"/>
          </LinearLayout>
          <ImageView android:id="@+id/deviceHeroIllustration" android:layout_width="112dp" android:layout_height="112dp" android:layout_marginStart="@dimen/ui_space_8" android:contentDescription="@string/device_illustration_description" android:scaleType="fitCenter" android:src="@drawable/pastillero"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/deviceConnectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_device_surface" android:orientation="vertical" android:gravity="center_vertical" android:padding="@dimen/ui_container_padding">
          <LinearLayout android:id="@+id/deviceConnectionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_device_icon">
              <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:padding="2dp" android:scaleType="fitCenter" android:src="@drawable/pastillero"/>
            </FrameLayout>
            <View android:layout_width="1dp" android:layout_height="72dp" android:layout_marginStart="@dimen/ui_space_8" android:layout_marginEnd="@dimen/ui_space_8" android:background="@color/device_divider"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:id="@+id/tvEstadoPastillero" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/device_disconnected" android:textAppearance="@style/MedAlarmTextSectionTitle"/>
              <LinearLayout android:id="@+id/deviceStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_4" android:background="@drawable/bg_device_status_inactive" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/ui_space_8" android:paddingTop="@dimen/ui_space_4" android:paddingEnd="@dimen/ui_space_12" android:paddingBottom="@dimen/ui_space_4">
                <View android:id="@+id/deviceStatusDot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_notification_dot"/>
                <TextView android:id="@+id/deviceStatusBadgeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/device_disconnected" android:textColor="@color/text_secondary" android:textAppearance="@style/MedAlarmTextSecondaryStrong"/>
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnBluetoothPastillero" style="@style/DeviceConnectionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_12" android:minHeight="48dp" android:maxLines="1" android:ellipsize="end" android:text="@string/device_connect_short" android:textColor="@color/white"/>
        </LinearLayout>
        <GridLayout android:id="@+id/deviceMetricsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_12" android:columnCount="2" android:useDefaultMargins="false">
          <include android:id="@+id/metricBluetooth" layout="@layout/view_device_metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="5dp"/>
