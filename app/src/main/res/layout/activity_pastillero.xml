          <include android:id="@+id/metricSync" layout="@layout/view_device_metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="5dp"/>
          <include android:id="@+id/metricCompartments" layout="@layout/view_device_metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="5dp"/>
        </GridLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_12" android:background="@drawable/bg_device_surface" android:orientation="vertical" android:padding="@dimen/ui_container_padding">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView style="@style/FunctionalIcon" android:src="@drawable/ic_info" app:tint="@color/device_accent"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_space_12" android:layout_weight="1" android:text="@string/device_status" android:textAppearance="@style/MedAlarmTextSectionTitle"/>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_space_12" android:background="@drawable/bg_device_surface_soft" android:orientation="vertical" android:paddingHorizontal="@dimen/ui_container_padding">
            <include android:id="@+id/deviceUptimeRow" layout="@layout/view_device_status_row" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/device_divider"/>
            <include android:id="@+id/deviceClockRow" layout="@layout/view_device_status_row" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/device_divider"/>
            <include android:id="@+id/deviceNextAlarmRow" layout="@layout/view_device_status_row" android:layout_width="match_parent" android:layout_height="wrap_content"/>
          </LinearLayout>
        </LinearLayout>
      </com.example.recordatoriomedicamentos.AdaptiveContentLayout>
    </com.example.recordatoriomedicamentos.MedAlarmRoot>
  </ScrollView>
</FrameLayout>
