<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_logout_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alarm_edit_time_title"
        android:textAppearance="@style/MedAlarmTextSectionTitle"
        android:textColor="@color/text_primary" />
    <TextView
        android:id="@+id/editSlotSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/MedAlarmTextSecondary"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">
        <NumberPicker
            android:id="@+id/editHourPicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/alarm_hour_picker_accessibility" />
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=":"
            android:textAppearance="@style/MedAlarmTextTimeSeparator"
            android:textColor="@color/text_primary" />
        <NumberPicker
            android:id="@+id/editMinutePicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:contentDescription="@string/alarm_minute_picker_accessibility" />
        <NumberPicker
            android:id="@+id/editMeridiemPicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:contentDescription="@string/alarm_meridiem_picker_accessibility" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncMedicines"
        style="@style/SecondaryOutlineButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="@string/alarm_sync_medicines"
        app:icon="@drawable/ic_medication"
        app:iconGravity="textStart"
        app:iconTint="@color/brand_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSlotCancel"
            style="@style/SecondaryOutlineButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/action_cancel" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSlotSave"
            style="@style/PrimaryActionButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
